{
  "name": "vapoursynth-companion",
  "version": "2.0.0-alpha.0",
  "description": "Popout companion window for the VapourSynth OFX plugin in DaVinci Resolve. Forked from VapourSage (https://github.com/Hank-tha-Cowdog/vapoursage).",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:credentials": "node --test electron/__test_keychain.js",
    "test:sample-inputs": "node --test --test-isolation=none --test-timeout=5000 electron/tools/__test_registry.js",
    "test:sample-output": "node --test --test-isolation=none --test-timeout=5000 electron/tools/__test_registry_output.js",
    "test:sample-lifecycle": "node --test --test-isolation=none --test-timeout=5000 electron/tools/__test_registry_lifecycle.js",
    "test:sample-filesystem": "node --test --test-isolation=none --test-timeout=5000 electron/tools/__test_registry_filesystem.js",
    "preview": "vite preview",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && node ../scripts/audit_release_payload.js --inputs-only && electron-builder && node ../scripts/audit_release_payload.js --output-only",
    "dist:audit": "node ../scripts/audit_release_payload.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "vapoursynth",
    "ofx",
    "resolve",
    "restoration",
    "arm64",
    "metal"
  ],
  "author": "Hank-tha-Cowdog",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@google/genai": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@uiw/react-codemirror": "^4.25.9",
    "keytar": "^7.9.0",
    "lucide-react": "^0.474.0",
    "openai": "^6.37.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.0.2",
    "vite": "^5.4.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.vapoursynth.companion",
    "productName": "VapourSynth Companion",
    "mac": {
      "minimumSystemVersion": "26.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": "Zachary Holbert (4ZT24C8JQZ)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "notarize": false
    },
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "!**/__test_*",
      "!**/*.map",
      "!**/node_modules/fast-uri/benchmark",
      "!**/node_modules/fast-uri/benchmark/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/electron/dist",
        "to": "licenses/electron",
        "filter": [
          "LICENSE",
          "LICENSES.chromium.html"
        ]
      },
      {
        "from": "../build-portable/portable/VapourSynth.ofx.bundle",
        "to": "OFX/VapourSynth.ofx.bundle",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../scripts",
        "to": "scripts",
        "filter": [
          "render_preview_frame.py",
          "probe_vs_plugins.py",
          "probe_rife.py",
          "resolve-query.py"
        ]
      },
      {
        "from": "electron",
        "to": "scripts",
        "filter": [
          "resolve-query.py"
        ]
      },
      {
        "from": "../build-ffprobe/payload/runtime/ffmpeg",
        "to": "runtime/ffmpeg",
        "filter": [
          "ffprobe"
        ]
      },
      {
        "from": "../build-ffprobe/payload/licenses/ffmpeg",
        "to": "licenses/ffmpeg",
        "filter": [
          "manifest.json",
          "materials/**/*"
        ]
      },
      {
        "from": ".",
        "to": "licenses/companion",
        "filter": [
          "LICENSE"
        ]
      },
      {
        "from": "../scripts",
        "to": "licenses/ffmpeg/recipient",
        "filter": [
          "rebuild_ffprobe.py"
        ]
      },
      {
        "from": "../docs",
        "to": "licenses/ffmpeg/recipient",
        "filter": [
          "ffprobe-recipient-build-draft.md"
        ]
      }
    ],
    "dmg": {
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
